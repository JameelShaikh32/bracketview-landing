{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "framework": "nextjs",
    "regions": ["bom1"],
    "redirects": [
        {
            "source": "/:path*",
            "has": [{ "type": "host", "value": "www.bracketview.in" }],
            "destination": "https://bracketview.in/:path*",
            "permanent": true
        }
    ],
    "functions": {
        "src/app/api/contact/route.ts": {
            "maxDuration": 30
        }
    }
}
