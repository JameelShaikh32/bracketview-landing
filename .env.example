# Public site URL (used for logo links in emails)
NEXT_PUBLIC_SITE_URL=https://bracketview.in

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXXXXX

# Google Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=XXXXXXXXXX

# Google AdSense (marketing site only — app stays ad-free)
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT=1234567890
# NEXT_PUBLIC_ADSENSE_SLOT_BLOG=1234567890
# NEXT_PUBLIC_ADSENSE_SLOT_CONTENT=0987654321

# SMTP configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="BracketView <support@bracketview.in>"

# Inbox that receives contact form submissions
CONTACT_INBOX=support@bracketview.in
