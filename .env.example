# Public site URL (used for logo links in emails)
NEXT_PUBLIC_SITE_URL=https://bracketview.in

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXXXXX

# Google Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=XXXXXXXXXX

# SMTP configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="BracketView <support@bracketview.in>"

# Inbox that receives contact form submissions
CONTACT_INBOX=support@bracketview.in
